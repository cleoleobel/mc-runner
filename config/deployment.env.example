# ==============================================================================
# NEXUS DEPLOYMENT ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# GitHub Fine-Grained Personal Access Token with write access to cleoleobel/nexus-storage
NEXUS_STORAGE_TOKEN=<github-token>

# Playit.gg Secret Key from https://playit.gg dashboard
PLAYIT_SECRET=<playit-agent-secret>

# Optional safety pin. The active Playit mapping must match or startup fails.
VOICECHAT_PUBLIC_HOST=atoms-draft.tun.ply.gg:54056

# Server Version Identifier
NEXUS_SERVER_VERSION=2026.08.08-01

# Minecraft & Voice Chat Ports
MINECRAFT_PORT=25565
VOICECHAT_PORT=24454

# Default session duration in minutes
SESSION_MINUTES=325
RESTORE_WORLD=yes
NEXUS_OPERATION=run-server
